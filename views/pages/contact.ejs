<section class="contact container">
  <div class="contact-panel">
  <h1 class="section-title">Contact Me</h1>
  <p class="section-intro">Send me your questions, comments and project-related queries.</p>

  <div class="mx-auto" style="max-width: 600px;">
    <% if (sent) { %>
      <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="fa-solid fa-circle-check fa-lg me-2"></i>
        <div>Thanks! Your message has been received and I'll get back to you soon.</div>
      </div>
    <% } %>
    <% if (errors.length) { %>
      <div class="alert alert-danger" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-1"></i> Please fix the following:
        <ul class="mb-0 mt-1">
          <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>
  </div>

  <!-- Contact form (POST /contact) -->
  <form action="/contact" method="POST" class="contact-form white-card needs-validation" novalidate>
    <div class="mb-3">
      <label for="name" class="form-label">Your Name</label>
      <div class="input-group has-validation">
        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
        <input type="text" class="form-control" id="name" name="name" placeholder="Jane Smith"
               required minlength="2" maxlength="60" autocomplete="name" value="<%= form.name || '' %>">
        <div class="invalid-feedback">Please enter your name.</div>
      </div>
    </div>
    <div class="mb-3">
      <label for="email" class="form-label">Your Email</label>
      <div class="input-group has-validation">
        <span class="input-group-text"><i class="fa-solid fa-at"></i></span>
        <input type="email" class="form-control" id="email" name="email" placeholder="jane@example.com"
               required autocomplete="email" value="<%= form.email || '' %>">
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>
    </div>
    <div class="mb-3">
      <label for="phone" class="form-label">Cell No.</label>
      <div class="input-group has-validation">
        <span class="input-group-text"><i class="fa-solid fa-mobile-screen"></i></span>
        <input type="tel" class="form-control" id="phone" name="phone" placeholder="905-555-1234"
               required pattern="[0-9]{3}-?[0-9]{3}-?[0-9]{4}" autocomplete="tel" value="<%= form.phone || '' %>">
        <div class="invalid-feedback">Enter a 10-digit number, like 905-555-1234.</div>
      </div>
    </div>
    <div class="mb-3">
      <label for="message" class="form-label">Message</label>
      <textarea class="form-control" id="message" name="message" rows="6" placeholder="Question, comment or query..."
                required minlength="10" maxlength="500"><%= form.message || '' %></textarea>
      <div class="invalid-feedback">Your message should be at least 10 characters.</div>
    </div>
    <div class="mb-1">
      <label for="robot" class="form-label">What is 1 + 1? (So I know you aren't a robot)</label>
      <div class="input-group has-validation">
        <span class="input-group-text"><i class="fa-solid fa-robot"></i></span>
        <input type="text" class="form-control" id="robot" name="robot" inputmode="numeric"
               placeholder="Your answer" required pattern="2" autocomplete="off">
        <div class="invalid-feedback">Type the number 2.</div>
      </div>
    </div>
    <button type="submit" class="btn btn-accent"><i class="fa-solid fa-paper-plane me-1"></i> Submit</button>
  </form>
  </div>
</section>
