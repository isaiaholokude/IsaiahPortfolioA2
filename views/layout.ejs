<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Isaiah Olokude</title>

  <!-- Google Fonts: Poppins, Caveat (handwritten notes), Playfair Display (About title) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Playfair+Display:ital,wght@1,700&family=Poppins:wght@300;400;500&display=swap">
  <!-- Bootstrap 5 CSS (source: https://getbootstrap.com) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 (source: https://fontawesome.com) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <!-- Custom theme from /public/stylesheets -->
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
</head>
<body class="d-flex flex-column min-vh-100">

  <%- include('partials/header') %>

  <main class="flex-grow-1">
    <%- body %>
  </main>

  <%- include('partials/footer') %>

  <!-- Bootstrap JS bundle (navbar toggle + modals) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom script from /public/javascripts -->
  <script src="/javascripts/app.js"></script>
</body>
</html>
