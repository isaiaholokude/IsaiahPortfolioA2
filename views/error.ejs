<section class="container text-center py-5">
  <i class="fa-solid fa-triangle-exclamation display-1 text-accent mb-3"></i>
  <h1 class="display-5"><%= error.status || 404 %> | <%= message %></h1>
  <p class="text-muted">Sorry, something went wrong or that page doesn't exist.</p>
  <a href="/" class="btn btn-accent mt-3"><i class="fa-solid fa-house me-1"></i> Back to Home</a>
  <% if (error.stack) { %>
    <pre class="text-start small bg-light p-3 mt-4 rounded"><%= error.stack %></pre>
  <% } %>
</section>
