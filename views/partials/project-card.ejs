<div class="project-row">
  <span class="project-icon"><i class="<%= p.icon %>"></i></span>
  <div>
    <p class="project-tag"><%= p.category %></p>
    <h2><%= p.title %></h2>
    <p class="small"><%= p.description %></p>
    <div>
      <% p.tags.forEach(function (t) { %>
        <span class="badge"><%= t %></span>
      <% }) %>
    </div>
  </div>
</div>
